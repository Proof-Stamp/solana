# Frontend configuration. Every VITE_* value is bundled into browser code and must be public.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_RPC_FALLBACK_URL=
# Leave blank for same-origin Cloudflare Pages. For split local development, point this at the local Pages server.
VITE_SUBMIT_API_BASE=

{
  "name": "proofstamp-solana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "npx --yes eslint@10.9.1 eslint.config.js scripts worker functions tests/worker.test.mjs",
    "format": "npx --yes prettier@3.9.6 --write eslint.config.js package.json .prettierrc .github/workflows/ci.yml",
    "format:check": "npx --yes prettier@3.9.6 --check eslint.config.js package.json .prettierrc .github/workflows/ci.yml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.2"
  },
  "dependencies": {
    "@solana-program/memo": "0.13.1",
    "@solana/kit": "8.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.11.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
